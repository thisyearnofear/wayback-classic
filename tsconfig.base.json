{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["tools/*"]
    },
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "allowJs": true,
    "sourceMap": true
  },
  "exclude": [
    "node_modules",
    "dist",
    ".yarn"
  ]
}